# ── Client (VITE_ prefix = shipped to the browser) ──────────────────────────
# Optional. Google Map Tiles API key → Photorealistic 3D Tiles on close-ups.
# Without it the map stays on OpenStreetMap building extrusions. Nothing breaks.
VITE_GOOGLE_3D_TILES_KEY=
# Flip to "true" once REPLIERS_API_KEY is a board-scoped (NEFMLS) key.
VITE_USE_LIVE_LISTINGS=false

# ── Server only (Netlify environment variables) ─────────────────────────────
# The AI concierge. Absent → the chat hides itself and a "Text Raegan" card shows.
ANTHROPIC_API_KEY=
ANTHROPIC_MODEL=claude-haiku-4-5
# MLS proxy for live listings. Absent → sample listings.
REPLIERS_API_KEY=
